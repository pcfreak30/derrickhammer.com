---
interface Props {
  eyebrow?: string;
  heading: string;
}

const { eyebrow, heading } = Astro.props;
---

<div class="section-heading">
  {eyebrow && <p class="eyebrow section-eyebrow">{eyebrow}</p>}
  <h2 class="section-title">{heading}</h2>
  <slot />
</div>

<style>
  .section-heading {
    margin-bottom: clamp(2.25rem, 4vh, 3.5rem);
  }

  .section-eyebrow {
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  :global(.section-intro) {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 1rem;
    max-width: 60ch;
  }
</style>
