---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const external = /^https?:\/\//i.test(href) || href.startsWith("//");
---

<a
  href={href}
  class={className}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>

<style></style>
